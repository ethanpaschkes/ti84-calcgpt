struct wifi_net { const char *ssid, *password; };
struct endpoint { const char *host; int port; int tls; const char *ssid; };   /* ssid "" = any network */
static const struct wifi_net WIFI_NETS[] = {
    {"My Home WiFi", "my home password"},
};
#define WIFI_NET_COUNT 1
static const struct endpoint ENDPOINTS[] = {
    {"192.168.1.50", 7878, 0, "My Home WiFi"},            /* calcnet on the Mac at home, plain */
    {"calcgpt.example.com", 443, 1, ""},                  /* the CalcGPT server, from any network, TLS */
};
#define ENDPOINT_COUNT (sizeof(ENDPOINTS) / sizeof(ENDPOINTS[0]))
#define CALC_SECRET "the shared calcnet secret"
#define DEVICE_ID_PADDED "exampleid\0\0\0\0\0\0\0"
