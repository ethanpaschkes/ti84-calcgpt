/* Copy to secrets.h and fill in (or run ../make_secrets.py, which writes it for you). secrets.h holds your Wi-Fi passwords and the
 * bridge secret, so it is never committed or shared. */
struct wifi_net { const char *ssid, *password; };
struct endpoint { const char *host; int port; int tls; int wifi; };   /* wifi: only on this network number (0 = the first), or -1 for any */
static const struct wifi_net WIFI_NETS[] = {
    {"home 2.4 GHz Wi-Fi name", "home password"},
    {"phone hotspot name", "hotspot password"},
};
#define WIFI_NET_COUNT (sizeof(WIFI_NETS) / sizeof(WIFI_NETS[0]))
static const struct endpoint ENDPOINTS[] = {
    {"192.168.1.50", 7878, 0, 0},                          /* the Mac at home, plain */
    {"my-mac.tailXXXX.ts.net", 10000, 1, -1},              /* the Mac's Tailscale Funnel name, encrypted, from anywhere */
};
#define ENDPOINT_COUNT (sizeof(ENDPOINTS) / sizeof(ENDPOINTS[0]))
#define CALC_SECRET "the text printed by:  python3 calcnet.py token"
